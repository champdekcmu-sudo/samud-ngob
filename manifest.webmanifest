{
  "name": "สมุดงบรายวัน",
  "short_name": "สมุดงบ",
  "description": "จดรายจ่ายรายวัน อ่านสลิปโอนเงิน และวางแผนออมเงิน",
  "lang": "th",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f2f5f4",
  "theme_color": "#1c6a61",
  "icons": [
    {"src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any"},
    {"src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any"},
    {"src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable"}
  ],
  "share_target": {
    "action": "share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [{"name": "slips", "accept": ["image/*"]}]
    }
  }
}
